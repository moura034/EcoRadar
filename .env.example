# Caminho opcional para o banco local. Por padrão: data/ecoradar.db
ECORADAR_DATABASE_PATH=

# Tempo limite HTTP, em segundos.
ECORADAR_HTTP_TIMEOUT=60

# Tempo de cache das leituras do dashboard, em segundos.
ECORADAR_CACHE_TTL=3600

# Proteção contra download acidental de muitos CSVs diários no modo interativo.
ECORADAR_MAX_LIVE_DAYS=31

# Nenhuma credencial é necessária para IBGE, INPE e Open-Meteo.
